{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tesla",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "routes": [
    { "pattern": "tesla.jaba.ge", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
