{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tesla",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "routes": [
    { "pattern": "tesla.jaba.ge", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sw.js"]
  },
  // The deployment id, stamped into /sw.js so each deployment updates the app on devices
  "version_metadata": { "binding": "VERSION" },
  "observability": { "enabled": true },
  // Short-lived mailbox for places sent from a phone (see /api/send, /api/inbox).
  // A database rather than KV: a place sent from a phone must be readable by the
  // car within seconds, and KV reads can lag a write by up to a minute.
  "d1_databases": [
    { "binding": "INBOX", "database_name": "geodrive-inbox", "database_id": "820fc301-e948-43d1-aa7a-7e6b3c56799d" }
  ]
}
