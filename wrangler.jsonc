{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tesla",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "routes": [
    { "pattern": "tesla.jaba.ge", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Live traffic along the route is off unless the GOOGLE_TRAFFIC secret is "on":
  //   npx wrangler secret put GOOGLE_TRAFFIC
  // A secret rather than a var so a deploy never flips it. See src/traffic.js.
  // Short-lived mailbox for places sent from a phone (see /api/send, /api/inbox).
  // A database rather than KV: a place sent from a phone must be readable by the
  // car within seconds, and KV reads can lag a write by up to a minute.
  "d1_databases": [
    { "binding": "INBOX", "database_name": "geodrive-inbox", "database_id": "820fc301-e948-43d1-aa7a-7e6b3c56799d" }
  ]
}
