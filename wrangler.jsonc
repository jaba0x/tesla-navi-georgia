{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tesla",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "routes": [
    { "pattern": "tesla.jaba.ge", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Short-lived mailbox for places sent from a phone (see /api/send, /api/inbox)
  "kv_namespaces": [
    { "binding": "INBOX", "id": "405ab533a21b433f9091753bfa0ea753" }
  ]
}
